{
  "name": "la-perla-indicadores-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "build:pages": "node scripts/build.mjs && node scripts/export-pages.mjs",
    "db:migrate": "wrangler d1 migrations apply la-perla-indicadores --remote",
    "deploy": "node scripts/build.mjs && wrangler deploy",
    "dev": "node scripts/build.mjs && wrangler dev"
  },
  "devDependencies": {
    "@fontsource/lato": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "wrangler": "4.164.0"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "jspdf": "4.2.0"
  }
}
